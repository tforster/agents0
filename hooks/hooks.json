{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/clean-config-lock.js"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/account-gate.js"]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SessionStart", "${CLAUDE_PLUGIN_ROOT}/rules/code-style.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SessionStart", "${CLAUDE_PLUGIN_ROOT}/rules/dev0.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SessionStart", "${CLAUDE_PLUGIN_ROOT}/rules/diataxis.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SessionStart", "${CLAUDE_PLUGIN_ROOT}/rules/javascript.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SessionStart", "${CLAUDE_PLUGIN_ROOT}/rules/markdown.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SessionStart", "${CLAUDE_PLUGIN_ROOT}/rules/testing.md"]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SubagentStart", "${CLAUDE_PLUGIN_ROOT}/rules/code-style.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SubagentStart", "${CLAUDE_PLUGIN_ROOT}/rules/dev0.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SubagentStart", "${CLAUDE_PLUGIN_ROOT}/rules/diataxis.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SubagentStart", "${CLAUDE_PLUGIN_ROOT}/rules/javascript.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SubagentStart", "${CLAUDE_PLUGIN_ROOT}/rules/markdown.md"]
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/inject-rule.js", "SubagentStart", "${CLAUDE_PLUGIN_ROOT}/rules/testing.md"]
          }
        ]
      }
    ]
  }
}
