{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": ["error", "all"]
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["skills/**", "agents/**", "rules/**", "adr/**"]
}
