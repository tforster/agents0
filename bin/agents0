#!/usr/bin/env node
// agents0 — CLI entry point (see PRD §10 for subcommand spec)
//
// Bootstrap on a new machine: `git clone`, then `node bin/agents0 install`, which
// links this file into ~/.local/bin (agents0.json "bin"). No install.sh (D67).

// System dependencies
import { fileURLToPath } from "node:url";
import path from "node:path";

// Local dependencies
import { loadConfig } from "../lib/config.js";
import { install, uninstall } from "../lib/install.js";
import { status } from "../lib/status.js";
import { sync } from "../lib/sync.js";
import { runJj } from "../lib/jj.js";
import { newSkill } from "../lib/new-skill.js";

const minimumNodeMajor = 24;

const scriptDir = path.dirname(fileURLToPath(import.meta.url));
const repoRoot = path.resolve(scriptDir, "..");

const [, , command, arg1, arg2] = process.argv;
const harnessName = arg1;
const usage = [
  "Usage: agents0 install [harness]     link every harness (or one) and the agents0 CLI",
  "       agents0 uninstall [harness]",
  "       agents0 status",
  "       agents0 sync",
  "       agents0 new skill <name>",
].join("\n");

/**
 * Runs the requested subcommand against the repo this script lives in.
 *
 * @returns {Promise<void>}
 */
async function main() {
  // Checked here rather than via package.json "engines", which only npm reads;
  // bootstrap runs `node bin/agents0` directly.
  const nodeMajor = Number(process.versions.node.split(".")[0]);
  if (nodeMajor < minimumNodeMajor) {
    console.error(`agents0 needs Node ${minimumNodeMajor} or later; this is Node ${process.versions.node}.`);
    process.exitCode = 1;
    return;
  }

  if (command === "status") {
    const config = await loadConfig(path.join(repoRoot, "agents0.json"));
    const report = await status({ config, toolkitRoot: repoRoot });
    printStatus(report);
    return;
  }

  if (command === "sync") {
    await sync({ runJj: (args) => runJj(args, { cwd: repoRoot }) });
    console.log("Synced.");
    return;
  }

  if (command === "new" && arg1 === "skill") {
    await newSkill(arg2, { toolkitRoot: repoRoot });
    console.log(`Created install/skills/${arg2}/SKILL.md.`);
    return;
  }

  if (command !== "install" && command !== "uninstall") {
    console.error(usage);
    process.exitCode = 1;
    return;
  }

  const config = await loadConfig(path.join(repoRoot, "agents0.json"));

  const scope = harnessName ?? "all harnesses";
  if (command === "install") {
    await install(harnessName, { config, toolkitRoot: repoRoot });
    console.log(`Installed ${scope}.`);
    if (config.bin) warnIfNotOnPath(path.dirname(config.bin));
  } else {
    await uninstall(harnessName, { config, toolkitRoot: repoRoot });
    console.log(`Uninstalled ${scope}.`);
  }
}

/**
 * Tells the user when the directory the CLI was linked into isn't on PATH
 * yet, e.g. a ~/.local/bin that ~/.profile only adds at the next login.
 *
 * @param {string} binDirectory - Directory holding the agents0 symlink.
 * @returns {void}
 */
function warnIfNotOnPath(binDirectory) {
  const pathEntries = (process.env.PATH ?? "").split(path.delimiter).map((entry) => path.resolve(entry));
  if (pathEntries.includes(path.resolve(binDirectory))) return;
  console.log(`Note: ${binDirectory} is not on PATH yet. Add it, or open a new login shell, to run \`agents0\` directly.`);
}

/**
 * Prints a per-harness, per-category status report to stdout.
 *
 * @param {Record<string, Record<string, string>>} report - Output of `status()`.
 * @returns {void}
 */
function printStatus(report) {
  for (const [harnessName, categories] of Object.entries(report)) {
    console.log(harnessName);
    for (const [category, state] of Object.entries(categories)) {
      console.log(`  ${category}: ${state}`);
    }
  }
}

main().catch((err) => {
  console.error(err.message);
  process.exitCode = 1;
});
